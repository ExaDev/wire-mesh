{
  "name": "wire-mesh",
  "version": "2.0.1",
  "bin": {
    "wire-mesh": "./dist/server.mjs"
  },
  "dependencies": {
    "cbor2": "2.3.0",
    "wire-mesh-core": "2.0.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@exadev/eslint-config": "2.18.0",
    "@exadev/wire-mesh-web-console": "2.0.1",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "exports": {
    "./adapters/node-websocket-transport": {
      "import": "./dist/adapters/node-websocket-transport.mjs",
      "require": "./dist/adapters/node-websocket-transport.cjs"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ExaDev/wire-mesh.git",
    "directory": "ts/packages/node"
  },
  "scripts": {
    "_build": "tsdown && node scripts/copy-web-console-dist.mjs",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "_test": "vitest run",
    "_typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "start": "node dist/server.mjs",
    "test": "turbo run _test",
    "typecheck": "turbo run _typecheck"
  },
  "type": "module"
}
