{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "ws"]
  },
  "include": [
    "src/adapters/node-websocket-transport.ts",
    "src/cli-options.ts",
    "src/server.ts",
    "src/static-console.ts"
  ]
}
