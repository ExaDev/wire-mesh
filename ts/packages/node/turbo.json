{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],

  "tasks": {
    "_build": {
      "inputs": ["src/**", "tsdown.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "_lint": {
      "dependsOn": ["_build"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.ts"],
      "outputs": [".eslintcache"]
    },
    "_test": {
      "dependsOn": ["_build"]
    },
    "_typecheck": {
      "dependsOn": ["_build"],
      "inputs": ["**/*.ts", "tsconfig.json", "tsconfig.node.json"]
    }
  }
}
