{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],

  "tasks": {
    "_build": {
      "inputs": ["src/**", "tsdown.config.ts", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "_build-wasm": {
      // The script compiles the Rust workspace, which sits above this pnpm workspace's root: unlike _generate's spec input, turbo does hash these paths, so a Rust edit invalidates the cached wasm-dist. The Cargo target directory is excluded because turbo's globs do not honour .gitignore and would otherwise hash cargo's own build output.
      "inputs": [
        "scripts/build-threshold-wasm.sh",
        "../../../rust/**",
        "!../../../rust/target/**"
      ],
      "outputs": ["wasm-dist/**"]
    },
    "_conformance-check": {
      "dependsOn": ["_build", "_build-wasm"]
    },
    "_generate": {
      "cache": false,
      "dependsOn": ["_build"],
      // Uncached, deliberately: the task's real input (../../../spec/protocol.cddl) lives above this pnpm workspace's root, and turbo refuses to hash workspace-external paths in both task inputs and globalDependencies -- so any cache hit here is keyed on generate.ts alone and replays stale output after a spec edit. Generation is a sub-second script; caching it buys nothing and the staleness is real.
      "inputs": ["generate.ts"]
    },
    "_lint": {
      "dependsOn": ["_build", "_build-wasm"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.ts"],
      "outputs": [".eslintcache"]
    },
    "_mutation": {
      "dependsOn": ["_build", "_build-wasm"]
    },
    "_test": {
      "dependsOn": ["_build", "_build-wasm"]
    },
    "_typecheck": {
      "dependsOn": ["_build", "_build-wasm"],
      "inputs": ["**/*.ts", "tsconfig.json", "tsconfig.node.json"]
    }
  }
}
